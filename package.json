{
  "name": "dsh-mobile-remote",
  "description": "DeepSeek Harness mobile pairing remote plugin (M2: E2EE pairing + LAN data plane)",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./lib/server/index.js",
  "exports": {
    ".": "./lib/server/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('lib', { recursive: true, force: true }))\"",
    "build:server": "node scripts/build-server.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build": "node scripts/build-server.mjs && node scripts/build-client.mjs && node scripts/build-mobile.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "js-sha256": "^1.0.0",
    "qrcode-generator": "^2.0.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
