{
  "name": "dsh-coding-remote-kit",
  "description": "DeepSeek Harness mobile pairing remote plugin: E2EE companion over a dual-plane allowlisted RPC (LAN / Tailscale / optional Cloudflare Quick Tunnel or self-hosted rendezvous).",
  "version": "0.2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lninghaha/dsh-coding-remote-kit.git"
  },
  "bugs": "https://github.com/lninghaha/dsh-coding-remote-kit/issues",
  "homepage": "https://github.com/lninghaha/dsh-coding-remote-kit#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mobile",
    "pairing",
    "e2ee",
    "companion",
    "dsh-coding-remote-kit"
  ],
  "main": "./lib/server/index.js",
  "exports": {
    ".": "./lib/server/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "INSTALL.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/00-project-rules.md",
    "docs/01-mvp-scope.md",
    "docs/02-architecture.md",
    "docs/02-architecture.zh-CN.md",
    "docs/03-protocol.md",
    "docs/04-threat-model.md",
    "docs/05-cloud-relay.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "README.pt-BR.md",
    "README.es.md",
    "README.fr.md",
    "README.de.md",
    "README.ru.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('lib', { recursive: true, force: true }))\"",
    "build:server": "node build/build-server.mjs",
    "build:client": "node build/build-client.mjs",
    "build:mobile": "node build/build-mobile.mjs",
    "build": "node build/build-server.mjs && node build/build-client.mjs && node build/build-mobile.mjs",
    "check": "pnpm build && pnpm test",
    "test": "node --test tests/*.test.js",
    "test:e2e": "bash scripts/e2e-mobile-scroll.sh",
    "test:sandbox": "bash scripts/sandbox-check.sh"
  },
  "dependencies": {
    "js-sha256": "^1.0.0",
    "qrcode-generator": "^2.0.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
